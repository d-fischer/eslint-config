{
  "name": "@d-fischer/eslint-config",
  "version": "8.0.1",
  "description": "My personal ESLint config.",
  "repository": {
    "type": "git",
    "url": "https://github.com/d-fischer/eslint-config.git"
  },
  "author": "Daniel Fischer <daniel@d-fischer.dev>",
  "funding": "https://github.com/sponsors/d-fischer",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "typescript-eslint": "^8.64.0",
    "eslint-plugin-fp": "^2.3.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.1.0"
  },
  "devDependencies": {
    "eslint": "^10.7.0",
    "husky": "^4.3.6",
    "lint-staged": "^15.2.2",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.7.0",
    "typescript": ">=4.5.2"
  },
  "files": [
    "index.js",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prettier:check": "prettier --check index.js",
    "prettier:fix": "prettier --write index.js"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,css,json,md}": "prettier --write"
  },
  "allowScripts": {
    "husky@4.3.8": true,
    "unrs-resolver@1.12.2": true
  }
}
